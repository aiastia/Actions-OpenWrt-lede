################################################################################
# OpenWrt x64 固件配置文件 - 完整版
# 组织方式：按功能模块分类，便于维护和查阅
################################################################################

################################################################################
# 第一部分：目标系统配置
################################################################################
# 编译目标：x86 64位架构
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y

# 启动方式配置
CONFIG_GRUB_IMAGES=y                     # GRUB 启动引导
CONFIG_EFI_IMAGES=y                      # UEFI 固件支持
CONFIG_TARGET_ROOTFS_PARTSIZE=2048
CONFIG_TARGET_KERNEL_PARTSIZE=512
################################################################################
# 第二部分：内核配置
################################################################################
CONFIG_LINUX_6_6=y                      # 使用 Linux 6.12内核（最新稳定版）
## CONFIG_TESTING_KERNEL=n
################################################################################
# 第三部分：文件系统配置
################################################################################
# 根文件系统
CONFIG_TARGET_ROOTFS_EXT4FS=y            # EXT4 文件系统支持

# 文件系统模块（可选，默认禁用）
#CONFIG_PACKAGE_kmod-fs-nfs=y             # NFS 支持
#CONFIG_PACKAGE_kmod-fs-nfs-common=y      # NFS 通用库
#CONFIG_PACKAGE_kmod-fs-nfs-v3=y          # NFS v3
#CONFIG_PACKAGE_kmod-fs-nfs-v4=y          # NFS v4
#CONFIG_PACKAGE_kmod-fs-ntfs=y            # NTFS 支持
CONFIG_PACKAGE_kmod-fs-squashfs=y        # SquashFS 支持

################################################################################
# 第四部分：网络协��和基础设施
################################################################################
# IPv6 支持
CONFIG_PACKAGE_dnsmasq_full_dhcpv6=y     # DNSMASQ DHCPv6 支持
CONFIG_PACKAGE_ipv6helper=y              # IPv6 辅助工具
CONFIG_PACKAGE_luci-proto-ipv6=y         # LuCI IPv6 协议支持

# IPv4 隧道
CONFIG_PACKAGE_6in4=y                    # 6in4 隧道协议支持（IPv6 over IPv4）

# 防火墙和 NAT（核心功能）
CONFIG_PACKAGE_firewall4=y               # 防火墙 4（x64 推荐）
# CONFIG_PACKAGE_firewall is not set
CONFIG_PACKAGE_kmod-nf-nathelper=y       # NAT 帮助模块（必需）
CONFIG_PACKAGE_kmod-nf-nathelper-extra=y # NAT 扩展模块（可选但推荐）

# DHCP 和 DNS
#CONFIG_PACKAGE_dnsmasq-full=y            # DNSMASQ 完整版（通常已包含）
#CONFIG_PACKAGE_dnsmasq=y                 # DNSMASQ 基础版（与 full 二选一）

################################################################################
# 第五部分：USB 和硬件支持
################################################################################
# USB 支持（默认禁用，按需启用）
#CONFIG_PACKAGE_kmod-usb-ohci=y           # OHCI 控制器
#CONFIG_PACKAGE_kmod-usb-ohci-pci=y       # PCI OHCI
#CONFIG_PACKAGE_kmod-usb2=y               # USB 2.0
#CONFIG_PACKAGE_kmod-usb2-pci=y           # PCI USB 2.0
#CONFIG_PACKAGE_kmod-usb3=y               # USB 3.0

# 其他硬件工具
CONFIG_PACKAGE_open-vm-tools=y           # VMware 工具支持
CONFIG_PACKAGE_snmpd=y                   # SNMP 服务（网络监控）

################################################################################
# 第六部分：存储和挂载（可选）
################################################################################
# 自动挂载配置（默认禁用）
##CONFIG_PACKAGE_block-mount is not set   # 块设备挂载工具
##CONFIG_PACKAGE_automount is not set     # 自动挂载

################################################################################
# 第七部分：镜像生成配置
################################################################################
# 镜像格式
CONFIG_TARGET_IMAGES_GZIP=y              # GZIP 压缩固件
#CONFIG_TARGET_IMAGES_PAD is not set      # 镜像填充（禁用）
#CONFIG_VMDK_IMAGES is not set            # VMware 镜像（禁用）

# 分区大小配置（单位：MB）


################################################################################
# 第八部分：网络功能类（代理、隧道、VPN）
################################################################################
# 代理和穿透
CONFIG_PACKAGE_luci-app-frpc=y           # FRP 客户端 Web 界面
CONFIG_PACKAGE_luci-i18n-frpc-zh-cn=y    # FRP 中文语言包
CONFIG_PACKAGE_luci-app-nps=y            # NPS 服务器 Web 界面
CONFIG_PACKAGE_luci-app-npc=y            # NPS 客户端 Web 界面
CONFIG_PACKAGE_npc=y                     # NPS 客户端

# VPN 和代理工具
##CONFIG_PACKAGE_luci-app-ssr-plus=y       # SSR Plus 代理工具
##CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Kcptun=y             # KCP 加速
##CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks=y        # Shadowsocks
##CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_ShadowsocksR_Server=y # SSR 服务器
##CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_ShadowsocksR_Socks=y  # SOCKS5
##CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_V2ray=y # V2Ray 支持
##CONFIG_PACKAGE_luci-app-v2ray-server=n   # V2Ray 服务器

CONFIG_PACKAGE_luci-app-passwall=y       # PassWall 代理工具
CONFIG_PACKAGE_luci-i18n-passwall-zh-cn=y # PassWall 中文语言包
CONFIG_PACKAGE_luci-app-passwall_Transparent_Proxy=y # 透明代理支持

# WireGuard VPN
##CONFIG_PACKAGE_wireguard-tools=y         # WireGuard 工具
##CONFIG_PACKAGE_kmod-wireguard=y          # WireGuard 内核模块（必需）
##CONFIG_PACKAGE_luci-app-wireguard=y      # WireGuard Web 界面
##CONFIG_PACKAGE_luci-proto-wireguard=y    # WireGuard 网络协议
##CONFIG_PACKAGE_luci-i18n-wireguard-zh-cn=y # WireGuard 中文语言包
##CONFIG_DEFAULT_luci-app-wireguard=y      # 默认启用 WireGuard

# DNS 和去广告
CONFIG_PACKAGE_luci-app-adguardhome=y    # AdGuard Home 去广告
#CONFIG_PACKAGE_luci-app-smartdns=y      # SmartDNS（可选）

################################################################################
# 第九部分：系统监控和管理
################################################################################
CONFIG_PACKAGE_luci-app-netdata=y        # Netdata 系统监控
CONFIG_PACKAGE_luci-i18n-netdata-zh-cn=y # Netdata 中文语言包
CONFIG_PACKAGE_luci-app-wrtbwmon=y       # 带宽监控工具

# 系统管理
CONFIG_PACKAGE_luci-app-webadmin=y       # Web 管理界面增强
CONFIG_PACKAGE_luci-app-store=y          # 应用商店
CONFIG_PACKAGE_luci-app-ota=y            # OTA 在线升级

# 终端工具
CONFIG_PACKAGE_luci-app-ttyd=y           # Web 终端

################################################################################
# 第十部分：文件共享（二选一）
################################################################################
# 方案 A：Samba4（推荐 - Windows/Mac/Linux 兼容性最好）
##CONFIG_PACKAGE_samba4-server=y          # Samba4 服务器
##CONFIG_PACKAGE_samba4-libs=y            # Samba4 库
##CONFIG_PACKAGE_samba4-utils=y           # Samba4 工具
##CONFIG_PACKAGE_luci-app-samba4=y        # Samba4 Web 界面
##CONFIG_PACKAGE_luci-i18n-samba4-zh-cn=y # Samba4 中文语言包

# 方案 B：ksmbd（高性能但需要内核 6.12+ 支持，当前已禁用）
CONFIG_PACKAGE_ksmbd=n
CONFIG_PACKAGE_kmod-ksmbd=n
# CONFIG_PACKAGE_autosamba is not set
# CONFIG_PACKAGE_ksmbd is not set
# CONFIG_PACKAGE_kmod-ksmbd is not set
# CONFIG_PACKAGE_kmod-fs-ksmbd is not set


################################################################################
# 第十一部分：常用命令行工具
################################################################################
CONFIG_PACKAGE_curl=y                    # HTTP/FTP 客户端
CONFIG_PACKAGE_wget=y                    # 网络下载工具
CONFIG_PACKAGE_nano=n                    # 文本编辑器
CONFIG_PACKAGE_vim-full=y                # VI 编辑器（完整版）
CONFIG_PACKAGE_htop=y                    # 交互式进程监控
CONFIG_PACKAGE_screen=y                  # 终端多路复用
CONFIG_PACKAGE_tree=y                    # 目录树显示
CONFIG_PACKAGE_unzip=y                   # 解压工具
CONFIG_PACKAGE_tcping=y                  # TCP ping 工具
CONFIG_PACKAGE_urngd=y                   # 随机数生成服务
##CONFIG_PACKAGE_python3=y                 # Python 3 解释器
CONFIG_PACKAGE_python3-light=y
################################################################################
# 第十二部分：LuCI 界面主题
################################################################################
CONFIG_PACKAGE_luci-app-argon-config=y   # Argon 主题配置
CONFIG_PACKAGE_luci-theme-argon=y        # Argon 主题（现代化）
CONFIG_PACKAGE_luci-theme-bootstrap=y    # Bootstrap 主题（经典）

################################################################################
# 第十三部分：已禁用的可选功能（参考）
